# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a Git.
# Sin estas variables la app funciona en modo práctica: el quiz califica pero no guarda (REQ-29 CA4).

# Project Settings → Data API → Project URL
SUPABASE_URL=
# Project Settings → API Keys → secret key (sb_secret_…). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Clave del panel docente (/docente). La elige el autor.
TEACHER_PASSCODE=
